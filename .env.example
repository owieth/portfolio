# Analytics — leave unset to no-op the whole layer (track() logs to the console).
# GA4 is configured inside the GTM container, so only the GTM id loads a script.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Server-only, for the GA4 Measurement Protocol (a later analytics layer).
GA4_API_SECRET=

# Supabase — server-only, and deliberately unprefixed: NEXT_PUBLIC_* is inlined
# at build time, so the key could not be rotated without a rebuild.
# Leave unset to no-op the layer; the client is then never constructed.
SUPABASE_URL=https://hqpjysfwwpgjlumxhrdi.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Rail reconcile only (`pnpm reconcile:data`), read from .env.local on the laptop
# that runs the December refresh. Never set it on Vercel: it is the database
# password, and nothing the site runs needs it. The session pooler string from
# the project's Connect dialog.
DATABASE_URL=

# Stats — unset hides /stats from the nav, the footer and the sitemap while the
# flights are still mocked. The route itself stays reachable either way.
NEXT_PUBLIC_STATS_ENABLED=
